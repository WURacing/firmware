# Editor-agnostic basics so every editor matches .clang-format.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ino,h,hpp,c,cpp}]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{py,ipynb}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.dbc]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
