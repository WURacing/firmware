{
  "problemMatcher": [
    {
      "owner": "clang-format",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning): (.+) \\[-Wclang-format-violations\\]$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "cpplint",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):\\s+(.+?)\\s+\\[([a-z_/+]+)\\] \\[\\d\\]$",
          "file": 1,
          "line": 2,
          "message": 3,
          "code": 4
        }
      ]
    }
  ]
}
